{
  "sheet": "Employees",
  "headerRow": 1,
  "skipEmptyRows": true,
  "trimSpace": true,
  "columns": {
    "EMP_NO": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 20,
      "pattern": "^[0-9]+$"
    },
    "EMPLOYEE_NAME": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 150
    },
    "EMAIL": {
      "type": "string",
      "format": "email"
    },
    "JOIN_DATE": {
      "type": "date",
      "required": true,
      "dateLayouts": [
        "2006-01-02",
        "02/01/2006"
      ],
      "allowExcelSerial": true
    },
    "SALARY": {
      "type": "number",
      "min": 0
    },
    "STATUS": {
      "type": "string",
      "allowedValues": [
        "PERMANENT",
        "CONTRACT",
        "PROBATION",
        "MAGANG",
        "PROHIRE",
        "BOD",
        "BOC",
        "ANGGOTABOC"
      ]
    }
  }
}